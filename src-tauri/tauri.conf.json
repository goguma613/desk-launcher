{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskLauncher",
  "version": "0.1.0",
  "identifier": "io.github.goguma613.desk-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "바탕화면 런처",
        "width": 220,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "런처 설정",
        "width": 560,
        "height": 680,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4MUVDMERCQjFEMThCRjQKUldUMGk5R3gyOEFlK0JicVZsZDhIS2NVWjViODZjQXdrZmZOOGFEeW1HRjdjYjcxa0VOOHhUOGkK",
      "endpoints": [
        "https://github.com/goguma613/desk-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
